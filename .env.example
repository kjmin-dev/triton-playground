# Triton Inference Server
MODEL_PROFILE=baseline
TRITON_RUNTIME_PROFILE=baseline
MODEL_PREPARE_FLAGS=
HF_HOME=.cache/huggingface
TRITON_SERVER_BIN=tritonserver
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.05-py3
TRITON_HTTP_PORT=18000
TRITON_GRPC_PORT=18001
TRITON_METRICS_PORT=18002
TRITON_HTTP_URL=http://localhost:18000
TRITON_GRPC_URL=localhost:18001
MODEL_REPOSITORY_ROOT=model_repository
MATERIALIZE_MANUAL_MODELS=0

# Worker API
WORKER_API_URL=http://localhost:8080
WORKER_HOST=0.0.0.0
WORKER_PORT=8080

# Web
WEB_HOST=0.0.0.0
WEB_PORT=4000
