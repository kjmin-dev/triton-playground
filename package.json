{
  "name": "triton-playground",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "bash scripts/setup.sh",
    "dev": "MODEL_PROFILE=localize MATERIALIZE_MANUAL_MODELS=1 bash scripts/dev.sh",
    "dev:triton": "MODEL_PROFILE=localize MATERIALIZE_MANUAL_MODELS=1 bash scripts/dev-triton.sh",
    "dev:web": "moon run web:dev",
    "dev:worker": "moon run worker:dev",
    "build": "moon run :build",
    "build:web": "moon run web:build",
    "prepare:models": "moon run worker:prepare-models --",
    "prepare:localize": "moon run worker:prepare-localize",
    "download:weights": "bash scripts/download-weights.sh",
    "prepare:manual-stubs": "moon run worker:prepare-manual-stubs",
    "lint": "moon run :lint",
    "format": "moon run :format",
    "test:worker": "moon run worker:test",
    "check": "moon run web:build worker:compile worker:test"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.1.3",
    "@types/bun": "^1.3.11"
  },
  "workspaces": [
    "packages/*"
  ]
}
