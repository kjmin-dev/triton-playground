{
  "name": "triton-playground",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "bash scripts/setup.sh",
    "dev": "moon run :dev",
    "dev:web": "moon run web:dev",
    "dev:worker": "moon run worker:dev",
    "build": "moon run :build",
    "build:web": "moon run web:build",
    "prepare:models": "moon run worker:prepare-models",
    "lint": "moon run :lint",
    "format": "moon run :format",
    "test:worker": "moon run worker:test",
    "check": "moon run web:build worker:compile worker:test"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.1.3",
    "@types/bun": "^1.3.11"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  }
}
